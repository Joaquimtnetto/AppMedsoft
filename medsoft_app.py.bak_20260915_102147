def current_build_metadata():
    """Em desenvolvimento, reflete a última alteração real dos fontes."""
    if BUILD_ENVIRONMENT != 'Desenvolvimento':
        return BUILD_DATETIME, BUILD_VERSION, BUILD_ENVIRONMENT
    project_root = Path(__file__).resolve().parent.parent
    source_roots = [
        project_root / 'backend',
        project_root / 'templates',
        project_root / 'static',
        project_root / 'whatsapp-baileys' / 'src',
    ]
    source_files = [project_root / 'whatsapp-baileys' / 'package.json']
    allowed_suffixes = {'.py', '.html', '.js', '.css', '.json'}
    ignored_parts = {'node_modules', 'sessions', 'message-history', 'logs', '__pycache__'}
    for source_root in source_roots:
        if not source_root.is_dir():
            continue
        source_files.extend(
            path for path in source_root.rglob('*')
            if path.is_file()
            and path.suffix.lower() in allowed_suffixes
            and not ignored_parts.intersection(path.parts)
        )
    timestamps = [path.stat().st_mtime for path in source_files if path.is_file()]
    latest = datetime.datetime.fromtimestamp(max(timestamps)).astimezone() if timestamps else datetime.datetime.now().astimezone()
    return latest.strftime('%d/%m/%Y %H:%M'), latest.strftime('%Y%m%d%H%M%S'), BUILD_ENVIRONMENT



